#!/bin/bash
# woltspace — run your wolts
#
# Usage:
#   woltspace init                    — first-time setup (or reconnect existing wolts)
#   woltspace start                   — start or resume container
#   woltspace stop                    — stop container (resumable with start)
#   woltspace restart                 — stop + start
#   woltspace update [version]        — update platform to latest (or specific) version
#   woltspace rebuild [--no-cache]    — rebuild tools image + start fresh
#   woltspace status                  — show version, container, wolts, tunnel
#   woltspace shell                   — enter running container
#   woltspace chat                    — open claude in container
#   woltspace logs                    — stream container logs
#   woltspace backup [tag] [--bundle] — snapshot container + wolts
#   woltspace version                 — show current version
#
# All state lives under ~/.woltspace/wolts (overridable via WOLTS_DIR).
# Platform source is mounted from the repo (where this script lives).
# The container is disposable — wolts/ is the backup.

set -e

# Resolve the woltspace installation directory (where this script lives)
WOLTSPACE_DIR="$(cd "$(dirname "$0")" && pwd)"

# Wolts directory — all wolt data lives here
WOLTS_DIR="${WOLTS_DIR:-$HOME/.woltspace/wolts}"
WOLTS_DIR="${WOLTS_DIR/#\~/$HOME}"

# Default name for default path, hash-suffixed for custom paths (avoids collisions)
if [ -n "${WOLTSPACE_CONTAINER:-}" ]; then
  CONTAINER_NAME="$WOLTSPACE_CONTAINER"
elif [ "$WOLTS_DIR" = "$HOME/.woltspace/wolts" ]; then
  CONTAINER_NAME="woltspace"
else
  _hash=$(printf '%s' "$WOLTS_DIR" | md5sum 2>/dev/null | cut -c1-6 || printf '%s' "$WOLTS_DIR" | md5 2>/dev/null | cut -c1-6)
  CONTAINER_NAME="woltspace-${_hash}"
fi
cmd="${1:-start}"

# Parse flags
NO_CACHE=false
for arg in "$@"; do
  if [ "$arg" = "--no-cache" ]; then
    NO_CACHE=true
  fi
done

# --- Colors ---
_D=$'\033[0;33m'; _L=$'\033[0;32m'; _C=$'\033[0;36m'
_G=$'\033[0;32m'; _B=$'\033[1m'; _R=$'\033[0m'

# --- Helpers ---

_build_image() {
  local cache_flag=""
  [ "$NO_CACHE" = true ] && cache_flag="--no-cache"

  echo "  ${_D}🪵 building tools image${_R}"
  echo "  ${_L}   felling fresh timber...${_R}"
  echo ""
  docker build -t woltspace $cache_flag \
    -f "$WOLTSPACE_DIR/container/Dockerfile" "$WOLTSPACE_DIR/container"
}

_start_container() {
  local wolt_name="${1:-}"
  docker rm -f "$CONTAINER_NAME" 2>/dev/null || true

  local extra_args=""
  [ -n "$wolt_name" ] && extra_args="-e WOLT_NAME=$wolt_name"

  mkdir -p "$WOLTS_DIR/.claude"
  # Ensure writable by container's node user (1000) — handles root-owned dirs from Docker
  chown 1000:1000 "$WOLTS_DIR/.claude" 2>/dev/null \
    || docker run --rm -v "$WOLTS_DIR/.claude:/fix" node:22-slim chown -R 1000:1000 /fix 2>/dev/null \
    || true
  docker run -d \
    --name "$CONTAINER_NAME" \
    --env-file "$WOLTS_DIR/.env" \
    -v "$WOLTS_DIR:/workspace/wolts:rw" \
    -v "$WOLTS_DIR/.claude:/home/node/.claude:rw" \
    -v "$WOLTSPACE_DIR:/workspace/woltspace:rw" \
    -p "${WOLTSPACE_PORT:-7777}":7777 \
    $extra_args \
    woltspace > /dev/null

  sleep 2
  if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
    echo "  ${_D}🧱 container failed to start. logs:${_R}"
    echo "  ${_L}   the dam broke${_R}"
    docker logs "$CONTAINER_NAME"
    exit 1
  fi
  echo "  ${_D}🏕️ container started${_R}"
  echo "  ${_L}   the lodge is open${_R}"
}

_show_url() {
  echo ""
  printf "  ${_D}🦫 ${_R}%bhttp://localhost:${WOLTSPACE_PORT:-7777}%b\n" "${_C}" "${_R}"
  echo "  ${_L}   the lodge is open${_R}"
  echo ""

  # Check if tunnel is enabled
  local env_file="$WOLTS_DIR/.env"
  local tunnel_enabled
  tunnel_enabled=$(grep '^WOLTSPACE_PUBLIC_TUNNEL=' "$env_file" 2>/dev/null | cut -d= -f2-)
  tunnel_enabled="${tunnel_enabled:-true}"

  if [ "$tunnel_enabled" = "true" ]; then
    TUNNEL_URL=""
    TUNNEL_FILE="$WOLTS_DIR/.space/platform/tunnel-url"
    [ ! -f "$TUNNEL_FILE" ] && TUNNEL_FILE="$WOLTS_DIR/.state/tunnel-url"  # backwards compat
    echo "  ${_D}🌲 starting tunnel${_R}"
    echo -n "  ${_L}   opening a path to the outside${_R}"
    for i in $(seq 1 30); do
      if [ -f "$TUNNEL_FILE" ]; then
        TUNNEL_URL=$(cat "$TUNNEL_FILE")
        [ -n "$TUNNEL_URL" ] && break
      fi
      echo -n "."; sleep 1
    done
    echo ""
    if [ -n "$TUNNEL_URL" ]; then
      printf "  public: %b%s%b\n" "${_C}" "$TUNNEL_URL" "${_R}"
      echo "  ${_D}share carefully — anyone with this link can reach your wolts.${_R}"
    else
      echo "  ${_D}tunnel still digging — check 'woltspace logs'${_R}"
    fi
  fi
  echo ""
}

_count_wolts() {
  local count=0
  for d in "$WOLTS_DIR"/*/wolt; do
    [ -d "$d" ] && count=$((count + 1))
  done
  echo "$count"
}

_list_wolt_names() {
  for d in "$WOLTS_DIR"/*/wolt; do
    [ -d "$d" ] && basename "$(dirname "$d")"
  done | sort
}

_current_version() {
  # Version pin in wolts dir, then git tag, then "unknown"
  if [ -f "$WOLTS_DIR/.version" ]; then
    cat "$WOLTS_DIR/.version"
  elif [ -d "$WOLTSPACE_DIR/.git" ]; then
    (cd "$WOLTSPACE_DIR" && git describe --tags --exact-match 2>/dev/null \
      || git describe --tags --abbrev=0 2>/dev/null \
      || git rev-parse --short HEAD 2>/dev/null \
      || echo "unknown")
  else
    echo "unknown"
  fi
}

_write_version_pin() {
  # Write current version to wolts/.version
  local version
  if [ -d "$WOLTSPACE_DIR/.git" ]; then
    version=$(cd "$WOLTSPACE_DIR" && git describe --tags --exact-match 2>/dev/null \
      || git describe --tags --abbrev=0 2>/dev/null \
      || git rev-parse --short HEAD 2>/dev/null \
      || echo "local")
  else
    version="local"
  fi
  mkdir -p "$WOLTS_DIR"
  echo "$version" > "$WOLTS_DIR/.version"
  echo "$version"
}

# --- PATH setup (idempotent) ---

_setup_path() {
  command -v woltspace &>/dev/null && return
  local _shell_rc=""
  case "$(basename "$SHELL")" in
    zsh)  _shell_rc="$HOME/.zshrc" ;;
    bash)
      [ -f "$HOME/.bash_profile" ] && _shell_rc="$HOME/.bash_profile" || _shell_rc="$HOME/.bashrc"
      ;;
  esac
  local _path_line="export PATH=\"$WOLTSPACE_DIR:\$PATH\""

  if [ -n "$_shell_rc" ] && grep -q '# >>> woltspace >>>' "$_shell_rc" 2>/dev/null; then
    export PATH="$WOLTSPACE_DIR:$PATH"
  elif [ -n "$_shell_rc" ]; then
    echo ""
    echo "  woltspace isn't on your PATH yet."
    echo -n "  ${_C}add it to $(basename "$_shell_rc")? [Y/n] (press enter for yes)${_R} "
    read -r _confirm </dev/tty
    _confirm="${_confirm:-Y}"
    if [[ "$_confirm" == [Yy] ]]; then
      echo "" >> "$_shell_rc"
      echo "# >>> woltspace >>>" >> "$_shell_rc"
      echo "$_path_line" >> "$_shell_rc"
      echo "# <<< woltspace <<<" >> "$_shell_rc"
      export PATH="$WOLTSPACE_DIR:$PATH"
      echo "  ${_D}done — added to $_shell_rc${_R}"
    fi
    echo ""
  fi
}

# --- Init ---

if [ "$cmd" = "init" ]; then
  if ! command -v docker &>/dev/null; then
    echo "error: docker not found — https://docs.docker.com/get-docker/"
    exit 1
  fi

  _setup_path

  # Detect existing wolts
  if [ -d "$WOLTS_DIR" ] && [ "$(_count_wolts)" -gt 0 ]; then
    printf "\n  %b🦫%b  %b\n\n" "${_L}" "${_R}" "${_B}${_G}woltspace${_R}"
    echo "  ${_D}🐘 found existing wolts:${_R}"
    echo "  ${_L}   the lodge remembers${_R}"
    _list_wolt_names | while read -r w; do echo "    🪵 $w"; done
    echo ""
    _build_image
    _write_version_pin > /dev/null
    _start_container
    _show_url
    exit 0
  fi

  # Fresh install — splash + name prompt
  if [ "${WOLTSPACE_NONINTERACTIVE:-}" = "true" ]; then
    NAME="${WOLTSPACE_WOLT_NAME:-wolt}"
    echo "  non-interactive: creating wolt '$NAME'"
  else
    clear
    printf "\n  %b🦫%b  %b\n\n" "${_L}" "${_R}" "${_B}${_G}woltspace${_R}"
    printf "  %b\n\n" "${_D}\"how much wolt could a wolt chuck chuck\n   if a wolt chuck could chuck wolt?\"${_R}"

    echo -n "  name your wolt: "
    read NAME </dev/tty
    if [ -z "$NAME" ]; then
      echo "error: name is required"
      exit 1
    fi

    echo ""
    printf "  %b%s%b is ready to start gnawing. 🦫🪵🌲\n" "${_B}${_L}" "$NAME" "${_R}"
    echo ""
    printf "  %bhere's what happens next:%b\n" "${_D}" "${_R}"
    printf "  %b  1. build a sandboxed docker container (a few minutes)%b\n" "${_D}" "${_R}"
    printf "  %b  2. log in to Claude Code (requires a claude.ai account)%b\n" "${_D}" "${_R}"
    printf "  %b  3. $NAME wakes up 🦫%b\n" "${_D}" "${_R}"
    echo ""
    printf "  %byour wolts will persist at %b%s%b\n" "${_D}" "${_R}${_C}" "$WOLTS_DIR" "${_R}"
    echo ""
    echo -n "  ${_C}continue? [Y/n] (press enter for yes)${_R} "
    read -r CONFIRM </dev/tty
    CONFIRM="${CONFIRM:-Y}"
    if [[ "$CONFIRM" != [Yy] ]]; then
      echo "  🦫 aborting. no wood was gnawed."
      exit 0
    fi
  fi
  echo ""

  # Create wolts dir + .env from template
  mkdir -p "$WOLTS_DIR"
  [ ! -f "$WOLTS_DIR/.env" ] && cp "$WOLTSPACE_DIR/.env.example" "$WOLTS_DIR/.env"

  # Tunnel opt-in
  if [ "${WOLTSPACE_NONINTERACTIVE:-}" = "true" ]; then
    _tunnel="n"
  else
    echo "  ${_D}enable public access?${_R}"
    echo ""
    echo "  ${_L}  create a temporary link so you can reach your woltspace from${_R}"
    echo "  ${_L}  anywhere — phone, other devices, etc.${_R}"
    echo "  ${_L}  the link changes every time you restart woltspace.${_R}"
    echo ""
    echo "  ${_D}  ⚠️  this is an experimental feature.${_R}"
    echo "  ${_D}  only share this link with people you trust.${_R}"
    echo "  ${_D}  see: https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/${_R}"
    echo ""
    echo -n "  ${_C}enable? [Y/n] (press enter for yes)${_R} "
    read -r _tunnel </dev/tty
    _tunnel="${_tunnel:-Y}"
  fi
  if [[ "$_tunnel" == [Yy] ]]; then
    echo ""
    echo "  ${_G}✓${_R} public access enabled"
    sed -i '' 's/^# WOLTSPACE_PUBLIC_TUNNEL=false/WOLTSPACE_PUBLIC_TUNNEL=true/' "$WOLTS_DIR/.env" 2>/dev/null || \
    sed -i 's/^# WOLTSPACE_PUBLIC_TUNNEL=false/WOLTSPACE_PUBLIC_TUNNEL=true/' "$WOLTS_DIR/.env"
  else
    echo ""
    echo "  ${_D}no worries — localhost:7777 only. you can enable it later in .env${_R}"
    sed -i '' 's/^# WOLTSPACE_PUBLIC_TUNNEL=false/WOLTSPACE_PUBLIC_TUNNEL=false/' "$WOLTS_DIR/.env" 2>/dev/null || \
    sed -i 's/^# WOLTSPACE_PUBLIC_TUNNEL=false/WOLTSPACE_PUBLIC_TUNNEL=false/' "$WOLTS_DIR/.env"
  fi
  echo ""

  # Build image
  _build_image

  # Write version pin
  _write_version_pin > /dev/null

  # Auth — run Claude login in a throwaway container if not already authenticated
  if [ ! -f "$WOLTS_DIR/.claude/.credentials.json" ] && [ "${WOLTSPACE_NONINTERACTIVE:-}" != "true" ]; then
    echo ""
    echo "  ${_D}🔑 almost there — log in to Claude Code${_R}"
    echo ""
    echo "  ${_L}  this will open a Claude Code session.${_R}"
    echo "  ${_L}  type /login, follow the prompts, then /exit when done.${_R}"
    echo "  ${_L}  you'll need a claude.ai account (free or pro).${_R}"
    echo ""
    echo -n "  ${_C}ready? [Y/n] (press enter for yes)${_R} "
    read -r _auth </dev/tty
    _auth="${_auth:-Y}"
    if [[ "$_auth" != [Yy] ]]; then
      echo ""
      echo "  ${_D}skipped — you can log in later from inside the container${_R}"
    else
    echo ""
    mkdir -p "$WOLTS_DIR/.claude"
    chown 1000:1000 "$WOLTS_DIR/.claude" 2>/dev/null \
      || docker run --rm -v "$WOLTS_DIR/.claude:/fix" node:22-slim chown -R 1000:1000 /fix 2>/dev/null \
      || true
    cat > "$WOLTS_DIR/.claude/CLAUDE.md" << 'LOGINMD'
# Woltspace Login

The user just logged in to Claude Code for the first time as part of woltspace setup.

Say: "welcome to woltspace! you're all set. type /exit or press ctrl+c to continue setup."

Keep it to one or two lines. Don't do anything else.
LOGINMD
    docker run --rm -it \
      -v "$WOLTS_DIR/.claude:/home/node/.claude:rw" \
      -e BROWSER= -e DISPLAY= \
      --entrypoint claude \
      woltspace || true
    rm -f "$WOLTS_DIR/.claude/CLAUDE.md"
    if [ -f "$WOLTS_DIR/.claude/.credentials.json" ]; then
      echo ""
      echo "  ${_G}✓${_R} logged in — $NAME can use Claude Code from day one"
    else
      echo ""
      echo "  ${_D}skipped — you can log in later from inside the container${_R}"
    fi
    fi
  fi
  echo ""

  # Start container
  _start_container "$NAME"
  _show_url

  printf "  %b$NAME is gnawing.%b open the link above to say hello.\n" "${_B}" "${_R}"
  echo ""
  exit 0
fi

# --- Validate ---

if [ ! -d "$WOLTS_DIR" ] || [ "$(_count_wolts)" -eq 0 ]; then
  if [ "$cmd" = "start" ]; then
    exec "$0" init
  fi
  echo ""
  echo "  🦫 no wolts found at $WOLTS_DIR"
  echo ""
  echo "  ${_D}if your wolts live elsewhere:${_R}"
  echo "    WOLTS_DIR=/path/to/wolts woltspace start"
  echo ""
  echo "  ${_D}or start a new lodge:${_R}"
  echo "    woltspace init"
  echo ""
  exit 1
fi

# --- Subcommands ---

case "$cmd" in
  stop)
    if [ "$2" = "--all" ]; then
      containers=$(docker ps --format '{{.Names}}' | grep '^woltspace' || true)
      if [ -z "$containers" ]; then
        echo "  no wolts running."
      else
        echo "$containers" | xargs docker stop > /dev/null
        echo "  🪵 stopped: $(echo "$containers" | tr '\n' ' ')"
      fi
    else
      docker stop "$CONTAINER_NAME" 2>/dev/null || true
      echo "  ${_D}🌙 container stopped${_R}"
      echo "  ${_L}   lodge closed for the night${_R}"
      echo "  ${_D}   run 'woltspace start' to resume${_R}"
    fi
    ;;
  restart)
    echo "  ${_D}🔄 restarting...${_R}"
    docker stop "$CONTAINER_NAME" 2>/dev/null || true
    rm -f "$WOLTS_DIR/.space/platform/tunnel-url" "$WOLTS_DIR/.state/tunnel-url"
    docker start "$CONTAINER_NAME" > /dev/null 2>&1 || {
      # Container was removed or doesn't exist — start fresh
      if ! docker image inspect woltspace &>/dev/null; then
        _build_image
      fi
      _start_container
    }
    _show_url
    ;;
  shell)
    docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$" || {
      echo "  ${_D}💤 container not running — run 'woltspace start'${_R}"
      echo "  ${_L}   the lodge is quiet${_R}"
      exit 1
    }
    docker exec -it "$CONTAINER_NAME" bash
    ;;
  chat)
    docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$" || {
      echo "  ${_D}💤 container not running — run 'woltspace start'${_R}"
      echo "  ${_L}   the lodge is quiet${_R}"
      exit 1
    }
    docker exec -it "$CONTAINER_NAME" claude --dangerously-skip-permissions
    ;;
  logs)
    docker logs -f "$CONTAINER_NAME"
    ;;
  update)
    # woltspace update [version]    — update to latest tag or specific version
    # woltspace update --nightly    — use main branch tip
    TARGET="${2:-}"

    if [ ! -d "$WOLTSPACE_DIR/.git" ]; then
      echo "  ${_D}error: $WOLTSPACE_DIR is not a git repo — can't update${_R}"
      echo "  ${_D}re-install with: curl -fsSL https://woltspace.com/install.sh | bash${_R}"
      exit 1
    fi

    echo ""
    echo "  ${_D}🔄 checking for updates...${_R}"
    CURRENT=$(_current_version)
    echo "  current: ${_C}$CURRENT${_R}"

    # Fetch latest
    (cd "$WOLTSPACE_DIR" && git fetch origin --tags --quiet)

    if [ "$TARGET" = "--nightly" ]; then
      echo "  ${_D}switching to main branch tip (nightly)${_R}"
      (cd "$WOLTSPACE_DIR" && git checkout main --quiet && git pull origin main --quiet)
      echo "HEAD" > "$WOLTS_DIR/.version"
      echo "  ${_G}✓${_R} now on main branch tip"
    elif [ -n "$TARGET" ]; then
      echo "  ${_D}checking out $TARGET...${_R}"
      (cd "$WOLTSPACE_DIR" && git checkout "$TARGET" --quiet) || {
        echo "  ${_D}error: version $TARGET not found${_R}"
        exit 1
      }
      echo "$TARGET" > "$WOLTS_DIR/.version"
      echo "  ${_G}✓${_R} now on $TARGET"
    else
      # Default: latest tag
      LATEST_TAG=$(cd "$WOLTSPACE_DIR" && git tag --sort=-v:refname | head -1)
      if [ -z "$LATEST_TAG" ]; then
        echo "  ${_D}no tags found — pulling main${_R}"
        (cd "$WOLTSPACE_DIR" && git checkout main --quiet && git pull origin main --quiet)
        _write_version_pin > /dev/null
      elif [ "$LATEST_TAG" = "$CURRENT" ]; then
        echo "  ${_G}✓${_R} already on latest: $LATEST_TAG"
        echo ""
        exit 0
      else
        echo "  ${_D}updating to $LATEST_TAG...${_R}"
        (cd "$WOLTSPACE_DIR" && git checkout "$LATEST_TAG" --quiet)
        echo "$LATEST_TAG" > "$WOLTS_DIR/.version"
        echo "  ${_G}✓${_R} updated to $LATEST_TAG"
      fi
    fi

    # Show changelog if available
    if [ -f "$WOLTSPACE_DIR/CHANGELOG.md" ]; then
      echo ""
      echo "  ${_D}changelog: $WOLTSPACE_DIR/CHANGELOG.md${_R}"
    fi

    # Check for migration script
    NEW_VERSION=$(_current_version)
    if [ -f "$WOLTSPACE_DIR/migrations/${NEW_VERSION}.sh" ]; then
      echo ""
      echo "  ${_D}running migration for $NEW_VERSION...${_R}"
      bash "$WOLTSPACE_DIR/migrations/${NEW_VERSION}.sh"
      echo "  ${_G}✓${_R} migration complete"
    fi

    # Restart container if running
    if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
      echo ""
      echo "  ${_D}restarting container...${_R}"
      docker rm -f "$CONTAINER_NAME" > /dev/null
      rm -f "$WOLTS_DIR/.space/platform/tunnel-url" "$WOLTS_DIR/.state/tunnel-url"
      _start_container
      _show_url
    else
      echo ""
      echo "  ${_D}container not running — run 'woltspace start' when ready${_R}"
    fi
    echo ""
    ;;
  backup)
    # Parse: woltspace backup [tag] [--bundle]
    BUNDLE=false
    TAG=""
    for arg in "${@:2}"; do
      if [ "$arg" = "--bundle" ]; then
        BUNDLE=true
      elif [ -z "$TAG" ]; then
        TAG="$arg"
      fi
    done
    TAG="${TAG:-$(date +%Y%m%d-%H%M%S)}"
    BACKUP_DIR="$(dirname "$WOLTS_DIR")/wolts-backup-$TAG"

    echo ""
    echo "  ${_D}🐘 snapshot tag: $TAG${_R}"
    echo "  ${_L}   backing up the lodge${_R}"
    echo ""

    # Container snapshot
    HAS_CONTAINER=false
    if docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
      HAS_CONTAINER=true
      echo "  ${_D}snapshotting container...${_R}"
      docker commit "$CONTAINER_NAME" "woltspace-backup:$TAG" > /dev/null
      echo "  ${_G}✓${_R} container → woltspace-backup:$TAG"
    else
      echo "  ${_D}no container found — skipping container snapshot${_R}"
    fi

    # Wolts backup
    echo "  ${_D}copying wolts...${_R}"
    rsync -a "$WOLTS_DIR/" "$BACKUP_DIR/"
    echo "  ${_G}✓${_R} wolts → $BACKUP_DIR"

    # Bundle into single zip
    if [ "$BUNDLE" = true ]; then
      BUNDLE_FILE="$(dirname "$WOLTS_DIR")/woltspace-backup-$TAG.zip"
      echo ""
      echo "  ${_D}bundling into portable zip...${_R}"

      TMPDIR=$(mktemp -d)
      if [ "$HAS_CONTAINER" = true ]; then
        echo "  ${_D}exporting image (this may take a minute)...${_R}"
        docker save "woltspace-backup:$TAG" > "$TMPDIR/image.tar"
      fi
      rsync -a "$BACKUP_DIR/" "$TMPDIR/wolts/"
      echo "$TAG" > "$TMPDIR/.tag"
      cat > "$TMPDIR/restore.sh" << 'RESTORE'
#!/bin/bash
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
TAG=$(cat "$DIR/.tag")
if [ -f "$DIR/image.tar" ]; then
  echo "loading container image..."
  docker load < "$DIR/image.tar"
fi
echo ""
echo "restore complete. run with:"
echo "  docker run -d --name woltspace \\"
echo "    -v $DIR/wolts:/workspace/wolts:rw \\"
echo "    -p 7777:7777 \\"
echo "    woltspace-backup:$TAG"
RESTORE
      chmod +x "$TMPDIR/restore.sh"

      (cd "$TMPDIR" && zip -qr "$BUNDLE_FILE" .)
      rm -rf "$TMPDIR"

      SIZE=$(du -sh "$BUNDLE_FILE" | cut -f1)
      echo "  ${_G}✓${_R} bundle → $BUNDLE_FILE ($SIZE)"
    fi

    echo ""
    echo "  ${_D}restore with:${_R}"
    if [ "$BUNDLE" = true ]; then
      echo "    unzip woltspace-backup-$TAG.zip -d woltspace-backup-$TAG"
      echo "    cd woltspace-backup-$TAG && bash restore.sh"
    else
      echo "    docker run -d --name $CONTAINER_NAME \\"
      echo "      -v $BACKUP_DIR:/workspace/wolts:rw \\"
      echo "      -p ${WOLTSPACE_PORT:-7777}:7777 \\"
      echo "      woltspace-backup:$TAG"
    fi
    echo ""
    ;;
  rebuild)
    echo "  ${_D}🪵 rebuilding tools image${_R}"
    echo "  ${_L}   felling fresh timber...${_R}"
    docker rm -f "$CONTAINER_NAME" 2>/dev/null || true
    rm -f "$WOLTS_DIR/.space/platform/tunnel-url" "$WOLTS_DIR/.state/tunnel-url"
    _build_image
    _start_container
    _show_url
    ;;
  start)
    printf "\n  %b🦫%b  %b\n\n" "${_L}" "${_R}" "${_B}${_G}woltspace${_R}"

    if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
      echo "  ${_D}🦫 container running${_R}"
      echo "  ${_L}   already gnawing${_R}"
      _show_url
    elif docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
      echo "  ${_D}☀️ resuming container${_R}"
      echo "  ${_L}   waking up the lodge...${_R}"
      rm -f "$WOLTS_DIR/.space/platform/tunnel-url" "$WOLTS_DIR/.state/tunnel-url"
      docker restart "$CONTAINER_NAME" > /dev/null
      _show_url
    else
      if ! docker image inspect woltspace &>/dev/null; then
        _build_image
      fi
      _start_container
      _show_url
    fi
    ;;
  status)
    printf "\n  %b🦫%b  %b\n\n" "${_L}" "${_R}" "${_B}${_G}woltspace${_R}"

    # Version
    echo "  ${_D}version:${_R}   $(_current_version)"

    # Container state
    if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
      echo "  ${_D}container:${_R} ${_G}running${_R}"
    elif docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
      echo "  ${_D}container:${_R} stopped"
    else
      echo "  ${_D}container:${_R} not created"
    fi

    # Wolts
    WOLT_COUNT=$(_count_wolts)
    echo "  ${_D}wolts:${_R}     $WOLT_COUNT"
    if [ "$WOLT_COUNT" -gt 0 ]; then
      _list_wolt_names | while read -r w; do echo "             🪵 $w"; done
    fi

    # Tunnel
    TUNNEL_FILE="$WOLTS_DIR/.space/platform/tunnel-url"
    [ ! -f "$TUNNEL_FILE" ] && TUNNEL_FILE="$WOLTS_DIR/.state/tunnel-url"
    if [ -f "$TUNNEL_FILE" ] && [ -n "$(cat "$TUNNEL_FILE" 2>/dev/null)" ]; then
      echo "  ${_D}tunnel:${_R}    ${_C}$(cat "$TUNNEL_FILE")${_R}"
    else
      echo "  ${_D}tunnel:${_R}    off"
    fi

    # Paths
    echo "  ${_D}source:${_R}    $WOLTSPACE_DIR"
    echo "  ${_D}data:${_R}      $WOLTS_DIR"
    echo ""
    ;;
  version)
    echo "  $(_current_version)"
    ;;
  *)
    echo "usage: woltspace <command>"
    echo ""
    echo "commands:"
    echo "  init                 first-time setup"
    echo "  start                start or resume container"
    echo "  stop                 stop container (resumable)"
    echo "  restart              stop + start"
    echo "  update [version]     update platform (latest tag, or specific version)"
    echo "  rebuild [--no-cache] rebuild tools image + start fresh"
    echo "  status               show version, container, wolts, tunnel"
    echo "  shell                enter running container"
    echo "  chat                 open claude in container"
    echo "  logs                 stream container logs"
    echo "  backup [tag]         snapshot (add --bundle for portable zip)"
    echo "  version              show current version"
    exit 1
    ;;
esac
