#!/bin/bash
# woltspace — run your wolts
#
# Usage:
#   woltspace init                    — first-time setup (or reconnect existing wolts)
#   woltspace start                   — start, restart, or resume container
#   woltspace stop                    — stop and remove container
#   woltspace rebuild                 — rebuild image + restart
#   woltspace shell                   — enter running container
#   woltspace chat                    — open claude in container
#   woltspace logs                    — stream container logs
#
# Flags:
#   --branch <name>   — build image from a specific branch (default: main)
#   --local           — build image from local repo instead of git clone
#
# All state lives under ~/.woltspace/wolts (overridable via WOLTS_DIR).
# The container is disposable — ~/wolts is the backup.

set -e

# Resolve the woltspace installation directory (where this script lives)
WOLTSPACE_DIR="$(cd "$(dirname "$0")" && pwd)"

# Wolts directory — all wolt data lives here
WOLTS_DIR="${WOLTS_DIR:-$HOME/.woltspace/wolts}"
WOLTS_DIR="${WOLTS_DIR/#\~/$HOME}"

CONTAINER_NAME="woltspace"
cmd="${1:-start}"

# Parse flags: --local, --branch <name>
LOCAL_BUILD=false
BUILD_BRANCH="main"
_next=""
for arg in "$@"; do
  if [ -n "$_next" ]; then
    BUILD_BRANCH="$arg"
    _next=""
  elif [ "$arg" = "--local" ]; then
    LOCAL_BUILD=true
  elif [ "$arg" = "--branch" ]; then
    _next=branch
  fi
done

# --- Colors ---
_G=$'\033[0;32m'; _B=$'\033[1m'; _D=$'\033[2m'; _R=$'\033[0m'
_A=$'\033[0;33m'; _C=$'\033[0;36m'

# --- Helpers ---

_build_image() {
  if [ "$LOCAL_BUILD" = true ]; then
    echo "  building woltspace image (local)..."
    echo ""
    docker build -t woltspace \
      --build-arg USE_LOCAL=true \
      -f "$WOLTSPACE_DIR/container/Dockerfile" "$WOLTSPACE_DIR"
  else
    echo "  building woltspace image (branch: $BUILD_BRANCH)..."
    echo ""
    docker build -t woltspace \
      --build-arg WOLTSPACE_BRANCH="$BUILD_BRANCH" \
      -f "$WOLTSPACE_DIR/container/Dockerfile" "$WOLTSPACE_DIR/container"
  fi
}

_start_container() {
  local wolt_name="${1:-}"
  docker rm -f "$CONTAINER_NAME" 2>/dev/null || true

  local extra_args=""
  [ -n "$wolt_name" ] && extra_args="-e WOLT_NAME=$wolt_name"

  docker run -d \
    --name "$CONTAINER_NAME" \
    --env-file "$WOLTS_DIR/.env" \
    -v "$WOLTS_DIR:/workspace/wolts:rw" \
    -p 7777:7777 \
    $extra_args \
    woltspace > /dev/null

  sleep 2
  if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
    echo "  container failed to start. logs:"
    docker logs "$CONTAINER_NAME"
    exit 1
  fi
  echo "  container started."
}

_show_url() {
  echo ""
  echo "  🦫 your wolts are gnawing at http://localhost:7777"
  echo ""

  # Check if tunnel is enabled
  local env_file="$WOLTS_DIR/.env"
  local tunnel_enabled
  tunnel_enabled=$(grep '^ENABLE_TUNNEL=' "$env_file" 2>/dev/null | cut -d= -f2-)
  tunnel_enabled="${tunnel_enabled:-true}"

  if [ "$tunnel_enabled" != "false" ]; then
    TUNNEL_URL=""
    TUNNEL_FILE="$WOLTS_DIR/.state/tunnel-url"
    echo -n "  setting up public tunnel"
    for i in $(seq 1 30); do
      if [ -f "$TUNNEL_FILE" ]; then
        TUNNEL_URL=$(cat "$TUNNEL_FILE")
        [ -n "$TUNNEL_URL" ] && break
      fi
      echo -n "."; sleep 1
    done
    echo ""
    if [ -n "$TUNNEL_URL" ]; then
      echo "  public URL: $TUNNEL_URL"
    else
      echo "  tunnel not ready — check 'woltspace logs'"
    fi
  fi
  echo ""
  echo "  to stop: woltspace stop"
  echo ""
}

_count_wolts() {
  local count=0
  for d in "$WOLTS_DIR"/*/wolt; do
    [ -d "$d" ] && count=$((count + 1))
  done
  echo "$count"
}

_list_wolt_names() {
  for d in "$WOLTS_DIR"/*/wolt; do
    [ -d "$d" ] && basename "$(dirname "$d")"
  done | sort
}

# --- PATH setup (idempotent) ---

_setup_path() {
  command -v woltspace &>/dev/null && return
  local _shell_rc=""
  case "$(basename "$SHELL")" in
    zsh)  _shell_rc="$HOME/.zshrc" ;;
    bash)
      [ -f "$HOME/.bash_profile" ] && _shell_rc="$HOME/.bash_profile" || _shell_rc="$HOME/.bashrc"
      ;;
  esac
  local _path_line="export PATH=\"$WOLTSPACE_DIR:\$PATH\""

  if [ -n "$_shell_rc" ] && grep -q '# >>> woltspace >>>' "$_shell_rc" 2>/dev/null; then
    export PATH="$WOLTSPACE_DIR:$PATH"
  elif [ -n "$_shell_rc" ]; then
    echo ""
    echo "  woltspace isn't on your PATH yet."
    echo -n "  ${_C}add it to $(basename "$_shell_rc")? [Y/n]${_R} "
    read -r _confirm </dev/tty
    _confirm="${_confirm:-Y}"
    if [[ "$_confirm" == [Yy] ]]; then
      echo "" >> "$_shell_rc"
      echo "# >>> woltspace >>>" >> "$_shell_rc"
      echo "$_path_line" >> "$_shell_rc"
      echo "# <<< woltspace <<<" >> "$_shell_rc"
      export PATH="$WOLTSPACE_DIR:$PATH"
      echo "  ${_D}done — added to $_shell_rc${_R}"
    fi
    echo ""
  fi
}

# --- Init ---

if [ "$cmd" = "init" ]; then
  if ! command -v docker &>/dev/null; then
    echo "error: docker not found — https://docs.docker.com/get-docker/"
    exit 1
  fi

  _setup_path

  # Detect existing wolts
  if [ -d "$WOLTS_DIR" ] && [ "$(_count_wolts)" -gt 0 ]; then
    printf "\n  %b🦫%b  %b\n\n" "${_A}" "${_R}" "${_B}${_G}woltspace${_R}"
    echo "  found existing wolts at $WOLTS_DIR:"
    _list_wolt_names | while read -r w; do echo "    · $w"; done
    echo ""
    _build_image
    _start_container
    _show_url
    echo "  open the link above in your browser."
    echo ""
    exit 0
  fi

  # Fresh install — splash + name prompt
  clear
  printf "\n  %b🦫%b  %b\n\n" "${_A}" "${_R}" "${_B}${_G}woltspace${_R}"
  printf "  %b\n\n" "${_D}\"how much wolt could a wolt chuck chuck\n   if a wolt chuck could chuck wolt?\"${_R}"

  echo -n "  name your wolt: "
  read NAME </dev/tty
  if [ -z "$NAME" ]; then
    echo "error: name is required"
    exit 1
  fi

  echo ""
  printf "  %b%s%b is ready to start gnawing. 🦫🪵🌲\n" "${_B}${_A}" "$NAME" "${_R}"
  echo ""
  printf "  %bthis will build a sandboxed docker container.%b\n" "${_D}" "${_R}"
  printf "  %byour wolts will persist at %b%s%b\n" "${_D}" "${_R}${_C}" "$WOLTS_DIR" "${_R}"
  echo ""
  echo -n "  ${_C}continue? [Y/n]${_R} "
  read -r CONFIRM </dev/tty
  CONFIRM="${CONFIRM:-Y}"
  if [[ "$CONFIRM" != [Yy] ]]; then
    echo "  🦫 aborting. no wood was gnawed."
    exit 0
  fi
  echo ""

  # Create wolts dir + .env from template
  mkdir -p "$WOLTS_DIR"
  [ ! -f "$WOLTS_DIR/.env" ] && cp "$WOLTSPACE_DIR/.env.example" "$WOLTS_DIR/.env"

  # Build + start — container handles wolt scaffolding on first boot
  _build_image
  _start_container "$NAME"
  _show_url

  echo "  open the link above in your browser to meet $NAME."
  echo ""
  exit 0
fi

# --- Validate ---

if [ ! -d "$WOLTS_DIR" ] || [ "$(_count_wolts)" -eq 0 ]; then
  if [ "$cmd" = "start" ]; then
    exec "$0" init
  fi
  echo ""
  echo "  🦫 no wolts gnawing at $WOLTS_DIR"
  echo ""
  echo "  if your wolts live elsewhere:"
  echo "    WOLTS_DIR=/path/to/wolts woltspace start"
  echo ""
  echo "  or start fresh:"
  echo "    woltspace init"
  echo ""
  exit 1
fi

# --- Subcommands ---

case "$cmd" in
  stop)
    if [ "$2" = "--all" ]; then
      containers=$(docker ps -a --format '{{.Names}}' | grep '^woltspace' || true)
      if [ -z "$containers" ]; then
        echo "  no woltspace containers running."
      else
        echo "$containers" | xargs docker rm -f > /dev/null
        echo "  stopped: $(echo "$containers" | tr '\n' ' ')"
      fi
    else
      docker rm -f "$CONTAINER_NAME" 2>/dev/null || true
      echo "  stopped $CONTAINER_NAME."
    fi
    ;;
  shell)
    docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$" || {
      echo "  container not running — use 'woltspace start'"
      exit 1
    }
    docker exec -it "$CONTAINER_NAME" bash
    ;;
  chat)
    docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$" || {
      echo "  container not running — use 'woltspace start'"
      exit 1
    }
    docker exec -it "$CONTAINER_NAME" claude --dangerously-skip-permissions
    ;;
  logs)
    docker logs -f "$CONTAINER_NAME"
    ;;
  rebuild)
    docker rm -f "$CONTAINER_NAME" 2>/dev/null || true
    rm -f "$WOLTS_DIR/.state/tunnel-url"
    _build_image
    _start_container
    _show_url
    ;;
  start)
    printf "\n  %b🦫%b  %b\n\n" "${_A}" "${_R}" "${_B}${_G}woltspace${_R}"

    if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
      echo "  already running."
      _show_url
    elif docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
      echo "  restarting..."
      rm -f "$WOLTS_DIR/.state/tunnel-url"
      docker restart "$CONTAINER_NAME" > /dev/null
      _show_url
    else
      if ! docker image inspect woltspace &>/dev/null; then
        _build_image
      fi
      _start_container
      _show_url
    fi
    ;;
  *)
    echo "usage: woltspace <init|start|stop|rebuild|shell|chat|logs> [--branch <name>] [--local]"
    exit 1
    ;;
esac
