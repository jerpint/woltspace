#!/bin/bash
# woltspace — run your wolts
#
# Usage:
#   woltspace init                    — first-time setup (or reconnect existing wolts)
#   woltspace start                   — start, restart, or resume container
#   woltspace stop                    — stop and remove container
#   woltspace rebuild                 — rebuild image + restart
#   woltspace shell                   — enter running container
#   woltspace chat                    — open claude in container
#   woltspace chat --session <slug>   — attach to a live wolt session in your terminal
#   woltspace logs                    — stream container logs
#   woltspace backup [tag]            — snapshot container + wolts (tag defaults to datetime)
#   woltspace backup [tag] --bundle  — same, but zipped into one portable file
#   woltspace update                  — check for updates and apply (spawns Claude)
#
# Flags:
#   --branch <name>   — build image from a specific branch (default: main)
#   --local           — build image from local repo instead of git clone
#
# All state lives under ~/.woltspace/wolts (overridable via WOLTS_DIR).
# The container is disposable — ~/wolts is the backup.

set -e

# Resolve the woltspace installation directory (where this script lives)
WOLTSPACE_DIR="$(cd "$(dirname "$0")" && pwd)"

# Wolts directory — all wolt data lives here
WOLTS_DIR="${WOLTS_DIR:-$HOME/.woltspace/wolts}"
WOLTS_DIR="${WOLTS_DIR/#\~/$HOME}"

# Default name for default path, hash-suffixed for custom paths (avoids collisions)
if [ -n "${WOLTSPACE_CONTAINER:-}" ]; then
  CONTAINER_NAME="$WOLTSPACE_CONTAINER"
elif [ "$WOLTS_DIR" = "$HOME/.woltspace/wolts" ]; then
  CONTAINER_NAME="woltspace"
else
  _hash=$(printf '%s' "$WOLTS_DIR" | md5sum 2>/dev/null | cut -c1-6 || printf '%s' "$WOLTS_DIR" | md5 2>/dev/null | cut -c1-6)
  CONTAINER_NAME="woltspace-${_hash}"
fi
cmd="${1:-start}"

# Parse flags: --local, --branch <name>
# WOLTSPACE_LOCAL=true is equivalent to --local (sticky dev mode)
LOCAL_BUILD="${WOLTSPACE_LOCAL:-false}"
BUILD_BRANCH="main"
BUILD_VERSION=""
BUILD_LATEST=false
NO_CACHE=false
_next=""
for arg in "$@"; do
  if [ -n "$_next" ]; then
    if [ "$_next" = "branch" ]; then BUILD_BRANCH="$arg";
    elif [ "$_next" = "version" ]; then BUILD_VERSION="$arg"; fi
    _next=""
  elif [ "$arg" = "--local" ]; then
    LOCAL_BUILD=true
  elif [ "$arg" = "--branch" ]; then
    _next=branch
  elif [ "$arg" = "--version" ]; then
    _next=version
  elif [ "$arg" = "--latest" ]; then
    BUILD_LATEST=true
  elif [ "$arg" = "--nightly" ]; then
    BUILD_VERSION="HEAD"
  elif [ "$arg" = "--no-cache" ]; then
    NO_CACHE=true
  fi
done

# --- Colors ---
# _D = yellow/orange (technical info, status)
# _L = green (lore, personality)
# _C = cyan (URLs, prompts)
# _G = green (success checkmarks)
# _B = bold
# _R = reset
_D=$'\033[0;33m'; _L=$'\033[0;32m'; _C=$'\033[0;36m'
_G=$'\033[0;32m'; _B=$'\033[1m'; _R=$'\033[0m'

# --- Helpers ---

_build_image() {
  local cache_flag=""
  [ "$NO_CACHE" = true ] && cache_flag="--no-cache"

  if [ "$LOCAL_BUILD" = true ]; then
    echo "  ${_D}🪵 building image from local source${_R}"
    echo "  ${_L}   felling fresh timber...${_R}"
    echo ""
    docker build -t woltspace $cache_flag \
      --build-arg USE_LOCAL=true \
      -f "$WOLTSPACE_DIR/container/Dockerfile" "$WOLTSPACE_DIR"
  else
    local version_arg=""
    if [ "${CURRENT_VERSION:-}" = "HEAD" ]; then
      echo "  ${_D}🪵 building image (nightly — main branch tip)${_R}"
      version_arg="--build-arg WOLTSPACE_VERSION=HEAD"
    elif [ -n "${CURRENT_VERSION:-}" ]; then
      echo "  ${_D}🪵 building image (version: $CURRENT_VERSION)${_R}"
      version_arg="--build-arg WOLTSPACE_VERSION=$CURRENT_VERSION"
    elif [ "$BUILD_BRANCH" != "main" ]; then
      echo "  ${_D}🪵 building image (branch: $BUILD_BRANCH)${_R}"
    else
      echo "  ${_D}🪵 building image (latest release)${_R}"
    fi
    echo "  ${_L}   felling fresh timber...${_R}"
    echo ""
    docker build -t woltspace $cache_flag $version_arg \
      --build-arg WOLTSPACE_BRANCH="$BUILD_BRANCH" \
      --build-arg CACHE_BUST="$(date +%s)" \
      -f "$WOLTSPACE_DIR/container/Dockerfile" "$WOLTSPACE_DIR/container"
  fi
}

_start_container() {
  local wolt_name="${1:-}"
  docker rm -f "$CONTAINER_NAME" 2>/dev/null || true

  local extra_args=""
  [ -n "$wolt_name" ] && extra_args="-e WOLT_NAME=$wolt_name"

  # Dev mode: mount local repo so code edits are live without rebuild
  local dev_mount=""
  if [ "$LOCAL_BUILD" = "true" ]; then
    dev_mount="-v $WOLTSPACE_DIR:/workspace/woltspace:rw"
    echo "  ${_L}   dev mount: $WOLTSPACE_DIR → /workspace/woltspace${_R}"
  fi

  mkdir -p "$WOLTS_DIR/.claude"
  docker run -d \
    --name "$CONTAINER_NAME" \
    --env-file "$WOLTS_DIR/.env" \
    -e HOST_UID=$(id -u) \
    -e HOST_GID=$(id -g) \
    -v "$WOLTS_DIR:/workspace/wolts:rw" \
    -v "$WOLTS_DIR/.claude:/home/node/.claude:rw" \
    $dev_mount \
    -p "${WOLTSPACE_PORT:-7777}":7777 \
    $extra_args \
    woltspace > /dev/null

  sleep 2
  if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
    echo "  ${_D}🧱 container failed to start. logs:${_R}"
    echo "  ${_L}   the dam broke${_R}"
    docker logs "$CONTAINER_NAME"
    exit 1
  fi
  echo "  ${_D}🏕️ container started${_R}"
  echo "  ${_L}   the lodge is open${_R}"
}

_show_url() {
  echo ""
  printf "  ${_D}🦫 ${_R}%bhttp://localhost:${WOLTSPACE_PORT:-7777}%b\n" "${_C}" "${_R}"
  echo "  ${_L}   the lodge is open${_R}"
  echo ""

  # Check if tunnel is enabled
  local env_file="$WOLTS_DIR/.env"
  local tunnel_enabled
  tunnel_enabled=$(grep '^WOLTSPACE_PUBLIC_TUNNEL=' "$env_file" 2>/dev/null | cut -d= -f2-)
  tunnel_enabled="${tunnel_enabled:-true}"

  if [ "$tunnel_enabled" = "true" ]; then
    TUNNEL_URL=""
    TUNNEL_STATE="$WOLTS_DIR/.space/platform/tunnel.json"
    echo "  ${_D}🌲 starting tunnel${_R}"
    echo -n "  ${_L}   opening a path to the outside${_R}"
    for i in $(seq 1 30); do
      if [ -f "$TUNNEL_STATE" ]; then
        TUNNEL_URL=$(grep -o '"url": *"[^"]*"' "$TUNNEL_STATE" 2>/dev/null | sed 's/"url": *"\(.*\)"/\1/')
        [ -n "$TUNNEL_URL" ] && break
      fi
      echo -n "."; sleep 1
    done
    echo ""
    if [ -n "$TUNNEL_URL" ]; then
      printf "  public: %b%s%b\n" "${_C}" "$TUNNEL_URL" "${_R}"
      echo "  ${_D}share carefully — anyone with this link can reach your wolts.${_R}"
    else
      echo "  ${_D}tunnel still digging — check 'woltspace logs'${_R}"
    fi
  fi
  echo ""
}

_count_wolts() {
  local count=0
  for d in "$WOLTS_DIR"/*/wolt; do
    [ -d "$d" ] && count=$((count + 1))
  done
  echo "$count"
}

_list_wolt_names() {
  for d in "$WOLTS_DIR"/*/wolt; do
    [ -d "$d" ] && basename "$(dirname "$d")"
  done | sort
}

# --- PATH setup (idempotent) ---

_setup_path() {
  command -v woltspace &>/dev/null && return
  local _shell_rc=""
  case "$(basename "$SHELL")" in
    zsh)  _shell_rc="$HOME/.zshrc" ;;
    bash)
      [ -f "$HOME/.bash_profile" ] && _shell_rc="$HOME/.bash_profile" || _shell_rc="$HOME/.bashrc"
      ;;
  esac
  local _path_line="export PATH=\"$WOLTSPACE_DIR:\$PATH\""

  if [ -n "$_shell_rc" ] && grep -q '# >>> woltspace >>>' "$_shell_rc" 2>/dev/null; then
    export PATH="$WOLTSPACE_DIR:$PATH"
  elif [ -n "$_shell_rc" ]; then
    echo ""
    echo "  woltspace isn't on your PATH yet."
    echo -n "  ${_C}add it to $(basename "$_shell_rc")? [Y/n] (press enter for yes)${_R} "
    read -r _confirm </dev/tty
    _confirm="${_confirm:-Y}"
    if [[ "$_confirm" == [Yy] ]]; then
      echo "" >> "$_shell_rc"
      echo "# >>> woltspace >>>" >> "$_shell_rc"
      echo "$_path_line" >> "$_shell_rc"
      echo "# <<< woltspace <<<" >> "$_shell_rc"
      export PATH="$WOLTSPACE_DIR:$PATH"
      echo "  ${_D}done — added to $_shell_rc${_R}"
      echo "  ${_D}run ${_R}${_C}source $_shell_rc${_R}${_D} to activate in this terminal${_R}"
    fi
    echo ""
  fi
}

# --- Init ---

if [ "$cmd" = "init" ]; then
  if ! command -v docker &>/dev/null; then
    echo "error: docker not found — https://docs.docker.com/get-docker/"
    exit 1
  fi

  _setup_path

  # Detect existing lodge (wolts or just scaffold from prior init)
  if [ -d "$WOLTS_DIR" ] && { [ "$(_count_wolts)" -gt 0 ] || [ -f "$WOLTS_DIR/.env" ]; }; then
    printf "\n  %b🦫%b  %b\n\n" "${_L}" "${_R}" "${_B}${_G}woltspace${_R}"
    if [ "$(_count_wolts)" -gt 0 ]; then
      echo "  ${_D}🐘 found existing wolts:${_R}"
      echo "  ${_L}   the lodge remembers${_R}"
      _list_wolt_names | while read -r w; do echo "    🪵 $w"; done
    else
      echo "  ${_D}🏕️ lodge exists, no wolts yet${_R}"
      echo "  ${_L}   resuming onboarding${_R}"
    fi
    echo ""
    if ! docker image inspect woltspace &>/dev/null; then
      _build_image
    fi
    _start_container
    _show_url
    exit 0
  fi

  # Fresh install
  if [ "${WOLTSPACE_NONINTERACTIVE:-}" = "true" ]; then
    NAME="${WOLTSPACE_WOLT_NAME:-}"
    [ -n "$NAME" ] && echo "  non-interactive: creating wolt '$NAME'"
  else
    clear
    printf "\n  %b🦫%b  %b\n\n" "${_L}" "${_R}" "${_B}${_G}woltspace${_R}"
    printf "  %b\n\n" "${_D}\"how much wolt could a wolt chuck chuck\n   if a wolt chuck could chuck wolt?\"${_R}"

    printf "  %bhere's what happens next:%b\n" "${_D}" "${_R}"
    printf "  %b  1. build a sandboxed docker container%b\n" "${_D}" "${_R}"
    printf "  %b  2. open the lodge and log in to Claude Code%b\n" "${_D}" "${_R}"
    printf "  %b  3. create your first wolt%b\n" "${_D}" "${_R}"
    echo ""
    printf "  %byour wolts will persist at %b%s%b\n" "${_D}" "${_R}${_C}" "$WOLTS_DIR" "${_R}"
    echo ""
    echo "  ${_D}enable public access?${_R}"
    echo "  ${_L}  creates a temporary link so you can reach woltspace from anywhere.${_R}"
    echo "  ${_L}  the link changes on every restart. only share with people you trust.${_R}"
    echo ""
    echo -n "  ${_C}enable public link? [Y/n]${_R} "
    read -r _tunnel </dev/tty
    _tunnel="${_tunnel:-Y}"
  fi

  # Create wolts dir + .env from template
  mkdir -p "$WOLTS_DIR"
  [ ! -f "$WOLTS_DIR/.env" ] && cp "$WOLTSPACE_DIR/.env.example" "$WOLTS_DIR/.env"

  # Ensure .claude dir exists for auth persistence (entrypoint handles ownership)
  mkdir -p "$WOLTS_DIR/.claude"
  if [[ "$_tunnel" == [Yy] ]]; then
    echo ""
    echo "  ${_G}✓${_R} public access enabled"
    # Set tunnel enabled explicitly
    sed -i '' 's/^# WOLTSPACE_PUBLIC_TUNNEL=false/WOLTSPACE_PUBLIC_TUNNEL=true/' "$WOLTS_DIR/.env" 2>/dev/null || \
    sed -i 's/^# WOLTSPACE_PUBLIC_TUNNEL=false/WOLTSPACE_PUBLIC_TUNNEL=true/' "$WOLTS_DIR/.env"
  else
    echo ""
    echo "  ${_D}no worries — localhost:7777 only. you can enable it later in .env${_R}"
    sed -i '' 's/^# WOLTSPACE_PUBLIC_TUNNEL=false/WOLTSPACE_PUBLIC_TUNNEL=false/' "$WOLTS_DIR/.env" 2>/dev/null || \
    sed -i 's/^# WOLTSPACE_PUBLIC_TUNNEL=false/WOLTSPACE_PUBLIC_TUNNEL=false/' "$WOLTS_DIR/.env"
  fi
  echo ""

  # Build image
  _build_image

  # Start container — no wolt name needed, auth + creation happen in the lodge
  _start_container ${NAME:+"$NAME"}
  _show_url

  echo "  ${_L}open the lodge to log in and create your first wolt.${_R}"
  echo ""
  exit 0
fi

# --- Validate ---

if [ ! -d "$WOLTS_DIR" ] || [ "$(_count_wolts)" -eq 0 ]; then
  # start behaves like init when no wolts exist (onboarding creates wolts in the lodge)
  if [ "$cmd" = "start" ]; then
    exec "$0" init
  fi
  # Allow container-management commands even with no wolts (onboarding)
  case "$cmd" in
    logs|shell|stop|chat) ;;  # fall through to subcommands
    *)
      echo ""
      echo "  🦫 no wolts found at $WOLTS_DIR"
      echo ""
      echo "  ${_D}if your wolts live elsewhere:${_R}"
      echo "    WOLTS_DIR=/path/to/wolts woltspace start"
      echo ""
      echo "  ${_D}or start a new lodge:${_R}"
      echo "    woltspace init"
      echo ""
      exit 1
      ;;
  esac
fi

# --- Subcommands ---

case "$cmd" in
  stop)
    if [ "$2" = "--all" ]; then
      containers=$(docker ps -a --format '{{.Names}}' | grep '^woltspace' || true)
      if [ -z "$containers" ]; then
        echo "  no wolts running."
      else
        echo "$containers" | xargs docker rm -f > /dev/null
        echo "  🪵 downed: $(echo "$containers" | tr '\n' ' ')"
      fi
    else
      docker rm -f "$CONTAINER_NAME" 2>/dev/null || true
      rm -f "$WOLTS_DIR/.space/platform/tunnel.json"
      echo "  ${_D}🌙 container stopped${_R}"
      echo "  ${_L}   lodge closed for the night${_R}"
    fi
    ;;
  shell)
    docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$" || {
      echo "  ${_D}💤 container not running — run 'woltspace start'${_R}"
      echo "  ${_L}   the lodge is quiet${_R}"
      exit 1
    }
    docker exec -it "$CONTAINER_NAME" bash
    ;;
  chat)
    docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$" || {
      echo "  ${_D}💤 container not running — run 'woltspace start'${_R}"
      echo "  ${_L}   the lodge is quiet${_R}"
      exit 1
    }
    # Parse: woltspace chat [--session <slug>]
    SESSION_SLUG=""
    shift  # drop 'chat'
    while [ $# -gt 0 ]; do
      case "$1" in
        --session)
          SESSION_SLUG="$2"
          shift 2
          ;;
        --session=*)
          SESSION_SLUG="${1#--session=}"
          shift
          ;;
        *)
          echo "  ${_D}unknown arg: $1${_R}"
          echo "  usage: woltspace chat [--session <slug>]"
          exit 1
          ;;
      esac
    done
    if [ -n "$SESSION_SLUG" ]; then
      if ! docker exec -u node "$CONTAINER_NAME" tmux has-session -t "$SESSION_SLUG" 2>/dev/null; then
        echo "  ${_D}🦝 no live session named '$SESSION_SLUG'${_R}"
        echo "  ${_L}   list live sessions:${_R} docker exec -u node $CONTAINER_NAME tmux ls"
        exit 1
      fi
      echo "  ${_D}🐾 attaching to $SESSION_SLUG — press C-b d to detach${_R}"
      docker exec -it -u node "$CONTAINER_NAME" tmux attach -t "$SESSION_SLUG"
    else
      docker exec -it "$CONTAINER_NAME" claude --dangerously-skip-permissions
    fi
    ;;
  logs)
    docker logs -f "$CONTAINER_NAME"
    ;;
  backup)
    # Parse: woltspace backup [tag] [--bundle]
    BUNDLE=false
    TAG=""
    for arg in "${@:2}"; do
      if [ "$arg" = "--bundle" ]; then
        BUNDLE=true
      elif [ -z "$TAG" ]; then
        TAG="$arg"
      fi
    done
    TAG="${TAG:-$(date +%Y%m%d-%H%M%S)}"
    BACKUP_DIR="$(dirname "$WOLTS_DIR")/wolts-backup-$TAG"

    echo ""
    echo "  ${_D}🐘 snapshot tag: $TAG${_R}"
    echo "  ${_L}   backing up the lodge${_R}"
    echo ""

    # Container snapshot
    HAS_CONTAINER=false
    if docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
      HAS_CONTAINER=true
      echo "  ${_D}snapshotting container...${_R}"
      docker commit "$CONTAINER_NAME" "woltspace-backup:$TAG" > /dev/null
      echo "  ${_G}✓${_R} container → woltspace-backup:$TAG"
    else
      echo "  ${_D}no container found — skipping container snapshot${_R}"
    fi

    # Wolts backup
    echo "  ${_D}copying wolts...${_R}"
    rsync -a "$WOLTS_DIR/" "$BACKUP_DIR/"
    echo "  ${_G}✓${_R} wolts → $BACKUP_DIR"

    # Bundle into single zip
    if [ "$BUNDLE" = true ]; then
      BUNDLE_FILE="$(dirname "$WOLTS_DIR")/woltspace-backup-$TAG.zip"
      echo ""
      echo "  ${_D}bundling into portable zip...${_R}"

      TMPDIR=$(mktemp -d)
      # Export docker image if we have one
      if [ "$HAS_CONTAINER" = true ]; then
        echo "  ${_D}exporting image (this may take a minute)...${_R}"
        docker save "woltspace-backup:$TAG" > "$TMPDIR/image.tar"
      fi
      # Copy wolts into bundle staging dir
      rsync -a "$BACKUP_DIR/" "$TMPDIR/wolts/"
      # Write restore script
      echo "$TAG" > "$TMPDIR/.tag"
      cat > "$TMPDIR/restore.sh" << 'RESTORE'
#!/bin/bash
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
TAG=$(cat "$DIR/.tag")
if [ -f "$DIR/image.tar" ]; then
  echo "loading container image..."
  docker load < "$DIR/image.tar"
fi
echo ""
echo "restore complete. run with:"
echo "  docker run -d --name woltspace \\"
echo "    -v $DIR/wolts:/workspace/wolts:rw \\"
echo "    -p 7777:7777 \\"
echo "    woltspace-backup:$TAG"
RESTORE
      chmod +x "$TMPDIR/restore.sh"

      # Zip it
      (cd "$TMPDIR" && zip -qr "$BUNDLE_FILE" .)
      rm -rf "$TMPDIR"

      SIZE=$(du -sh "$BUNDLE_FILE" | cut -f1)
      echo "  ${_G}✓${_R} bundle → $BUNDLE_FILE ($SIZE)"
    fi

    echo ""
    echo "  ${_D}restore with:${_R}"
    if [ "$BUNDLE" = true ]; then
      echo "    unzip woltspace-backup-$TAG.zip -d woltspace-backup-$TAG"
      echo "    cd woltspace-backup-$TAG && bash restore.sh"
    else
      echo "    docker run -d --name $CONTAINER_NAME \\"
      echo "      -v $BACKUP_DIR:/workspace/wolts:rw \\"
      echo "      -p ${WOLTSPACE_PORT:-7777}:7777 \\"
      echo "      woltspace-backup:$TAG"
    fi
    echo ""
    ;;
  rebuild)
    # Resolve version: --version > --latest > current container version
    CURRENT_VERSION=""
    if [ -n "$BUILD_VERSION" ]; then
      CURRENT_VERSION="$BUILD_VERSION"
    elif [ "$BUILD_LATEST" = true ]; then
      CURRENT_VERSION=""  # empty = Dockerfile picks latest tag
    elif [ "$LOCAL_BUILD" != true ] && [ "$BUILD_BRANCH" = "main" ]; then
      CURRENT_VERSION=$(docker exec "$CONTAINER_NAME" cat /workspace/woltspace/.version 2>/dev/null || echo "")
    fi
    if [ "$LOCAL_BUILD" = true ]; then
      echo "  ${_D}🪵 rebuilding from local — $WOLTSPACE_DIR${_R}"
      echo "  ${_L}   felling local timber...${_R}"
    elif [ "${CURRENT_VERSION:-}" = "HEAD" ]; then
      echo "  ${_D}🪵 rebuilding from main branch tip (nightly)${_R}"
      echo "  ${_L}   living on the edge...${_R}"
    elif [ -n "${CURRENT_VERSION:-}" ]; then
      echo "  ${_D}🪵 rebuilding at $CURRENT_VERSION${_R}"
      echo "  ${_L}   same version, fresh timber${_R}"
    elif [ "$BUILD_BRANCH" != "main" ]; then
      echo "  ${_D}🪵 rebuilding from branch $BUILD_BRANCH${_R}"
      echo "  ${_L}   felling branch timber...${_R}"
    else
      echo "  ${_D}🪵 rebuilding to latest release${_R}"
      echo "  ${_L}   upgrading the lodge...${_R}"
    fi
    docker rm -f "$CONTAINER_NAME" 2>/dev/null || true
    rm -f "$WOLTS_DIR/.space/platform/tunnel.json"
    _build_image
    _start_container
    _show_url
    ;;
  start)
    printf "\n  %b🦫%b  %b\n\n" "${_L}" "${_R}" "${_B}${_G}woltspace${_R}"
    if [ "$LOCAL_BUILD" = true ]; then
      echo "  ${_D}🪵 local build — $WOLTSPACE_DIR${_R}"
      echo "  ${_L}   gnawing on local timber${_R}"
      echo ""
    fi

    if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
      echo "  ${_D}🦫 container running${_R}"
      echo "  ${_L}   already gnawing${_R}"
      _show_url
    elif docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
      echo "  ${_D}☀️ resuming container${_R}"
      echo "  ${_L}   waking up the lodge...${_R}"
      rm -f "$WOLTS_DIR/.space/platform/tunnel.json"
      docker restart "$CONTAINER_NAME" > /dev/null
      _show_url
    else
      if ! docker image inspect woltspace &>/dev/null; then
        _build_image
      fi
      _start_container
      _show_url
    fi
    ;;
  update)
    if ! command -v claude &>/dev/null; then
      echo ""
      echo "  ${_D}🪵 woltspace update requires Claude Code CLI${_R}"
      echo "  ${_L}   install it: https://docs.anthropic.com/en/docs/claude-code/overview${_R}"
      echo ""
      exit 1
    fi
    echo ""
    printf "  %b🦫%b  %b\n\n" "${_L}" "${_R}" "${_B}${_G}woltspace update${_R}"
    echo "  ${_L}   updateWolt will walk you through the update${_R}"
    echo ""
    cd "$WOLTSPACE_DIR"
    claude "/woltspace-update"
    ;;
  *)
    echo "usage: woltspace <init|start|stop|rebuild|backup|shell|chat|logs|update>"
    echo "       woltspace rebuild [--latest|--version X|--nightly|--branch X|--no-cache]"
    echo "       woltspace backup [tag] [--bundle]"
    exit 1
    ;;
esac
