#!/bin/bash
# woltspace — run your wolt
#
# Usage:
#   woltspace init           — create a new wolt
#   woltspace start          — start container + launch claude inside it
#   woltspace stop           — stop and remove container
#   woltspace shell          — enter running container
#   woltspace rebuild        — force rebuild + restart
#   woltspace logs           — stream container logs
#
# init creates a new wolt directory from the template.
# All other commands expect to be run from a wolt repo directory.

set -e

# Resolve the woltspace installation directory (where this script lives)
WOLTSPACE_DIR="$(cd "$(dirname "$0")" && pwd)"

# The wolt repo is the current working directory
WOLT_DIR="$(pwd)"

cmd="${1:-start}"

# --- Helper: ensure container is running and get tunnel URL ---

_ensure_container() {
  local container_name="$1"
  local wolt_dir="$2"

  if docker ps --format '{{.Names}}' | grep -q "^${container_name}$"; then
    echo "  container already running."
  else
    echo "  building woltspace image (first time takes a few minutes)..."
    echo ""
    docker build -t woltspace -f "$WOLTSPACE_DIR/container/Dockerfile" "$WOLTSPACE_DIR"
    docker rm -f "$container_name" 2>/dev/null || true
    mkdir -p "$wolt_dir/.claude"

    local deploy_key_mount=""
    local deploy_key
    deploy_key=$(grep '^DEPLOY_KEY=' "$wolt_dir/.env" 2>/dev/null | cut -d= -f2-)
    deploy_key="${deploy_key:-$HOME/.ssh/deploy-key}"
    if [ -f "$deploy_key" ]; then
      deploy_key_mount="-v $deploy_key:/home/node/.ssh/deploy-key:ro"
    fi

    local oauth_token
    oauth_token=$(grep '^CLAUDE_CODE_OAUTH_TOKEN=' "$wolt_dir/.env" 2>/dev/null | cut -d= -f2-)

    docker run -d \
      --name "$container_name" \
      --env-file "$wolt_dir/.env" \
      -v "$wolt_dir:/workspace/wolt:rw" \
      -v "$wolt_dir/.claude:/home/node/.claude:rw" \
      $deploy_key_mount \
      -e WOLT_DIR=/workspace/wolt \
      -e CLAUDE_CODE_OAUTH_TOKEN="$oauth_token" \
      woltspace > /dev/null

    sleep 2
    if ! docker ps --format '{{.Names}}' | grep -q "^${container_name}$"; then
      echo "  container failed to start. logs:"
      docker logs "$container_name"
      exit 1
    fi
    echo "  container started."
  fi

  # Wait for tunnel URL
  TUNNEL_URL=""
  echo -n "  waiting for tunnel"
  for i in $(seq 1 30); do
    TUNNEL_URL=$(docker logs "$container_name" 2>&1 | grep -o 'https://[^ ]*trycloudflare.com' | head -1)
    if [ -n "$TUNNEL_URL" ]; then
      break
    fi
    echo -n "."
    sleep 1
  done
  echo ""

  if [ -n "$TUNNEL_URL" ]; then
    echo ""
    echo "  your wolt is live at: $TUNNEL_URL"
    echo ""
    echo "  note: the \"Bypass Permissions\" warning below is safe to ignore."
    echo "  claude is running inside a container, sandboxed from your system."
    echo ""
  else
    echo ""
    echo "  (tunnel not ready yet — check 'woltspace logs' for the URL)"
    echo ""
  fi
}

# --- Init: create a new wolt (runs before wolt dir validation) ---

if [ "$cmd" = "init" ]; then
  # Check prereqs
  if ! command -v docker &>/dev/null; then
    echo "error: docker not found"
    echo "install docker: https://docs.docker.com/get-docker/"
    exit 1
  fi
  if ! command -v claude &>/dev/null; then
    echo "error: claude CLI not found"
    echo "install: npm install -g @anthropic-ai/claude-code"
    exit 1
  fi

  # --- Splash screen ---
  clear
  cat << 'SPLASH'

  ▄   ▄  ▄▄▄  █    ■   ▄▄▄ ▄▄▄▄  ▗▞▀▜▌▗▞▀▘▗▞▀▚▖
  █ ▄ █ █   █ █ ▗▄▟▙▄▖▀▄▄  █   █ ▝▚▄▟▌▝▚▄▖▐▛▀▀▘
  █▄█▄█ ▀▄▄▄▀ █   ▐▌  ▄▄▄▀ █▄▄▄▀          ▝▚▄▄▖
              █   ▐▌       █
                  ▐▌       ▀

  ╔═══════════════════════════════════════════════════════════╗
  ║                                                           ║
  ║  a wolt is an AI agent with a home -- a space it builds   ║
  ║  and maintains in collaboration with a human partner.     ║
  ║                                                           ║
  ║  setup happens through a conversation with claude code.   ║
  ║  claude runs inside a container, sandboxed from your      ║
  ║  system, so it's safe to let it work autonomously.        ║
  ║                                                           ║
  ╚═══════════════════════════════════════════════════════════╝

SPLASH

  echo -n "  name your wolt: "
  read NAME

  if [ -z "$NAME" ]; then
    echo "error: name is required"
    exit 1
  fi

  TARGET="$(pwd)/$NAME"
  if [ -d "$TARGET" ]; then
    echo "error: $TARGET already exists"
    exit 1
  fi

  echo ""
  echo "  your wolt will be created at $TARGET"
  echo ""
  echo "  press enter to begin building your woltspace."
  echo "  this will set up a local docker container where your wolt"
  echo "  can explore and roam freely, sandboxed from your system."
  read -r

  # Create wolt from template
  cp -r "$WOLTSPACE_DIR/template" "$TARGET"

  # Create .gitignore
  cat > "$TARGET/.gitignore" << 'GITEOF'
.env
.claude/.credentials.json
.claude/statsig/
node_modules/
GITEOF

  # Create .env
  cat > "$TARGET/.env" << ENVEOF
WOLT_NAME=$NAME
HUMAN_NAME=
ENVEOF

  # Init git repo
  git init -q "$TARGET"

  # Ensure .claude dir exists for container mount
  mkdir -p "$TARGET/.claude"

  # Start the container (remove any stale one with the same name)
  CONTAINER_NAME="woltspace-${NAME}"
  docker rm -f "$CONTAINER_NAME" 2>/dev/null || true
  _ensure_container "$CONTAINER_NAME" "$TARGET"

  # Copy onboarding skill so host Claude discovers it
  mkdir -p "$TARGET/.claude/skills/create-wolt"
  cp "$WOLTSPACE_DIR/container/skills/create-wolt/SKILL.md" "$TARGET/.claude/skills/create-wolt/"

  # Launch Claude on the host for onboarding
  cd "$TARGET"
  exec claude "/create-wolt — your tunnel URL is $TUNNEL_URL"
fi

# --- Validate wolt directory ---

if [ ! -d "$WOLT_DIR/wolt" ]; then
  echo "error: not a wolt repo (no wolt/ directory found in $(pwd))"
  echo "hint: run woltspace commands from your wolt repo directory, e.g.:"
  echo "  cd ~/your-wolt && woltspace $cmd"
  exit 1
fi

# Read wolt name from .env or default to directory name
WOLT_NAME=$(grep '^WOLT_NAME=' "$WOLT_DIR/.env" 2>/dev/null | cut -d= -f2- || basename "$WOLT_DIR")
WOLT_NAME="${WOLT_NAME:-$(basename "$WOLT_DIR")}"

CONTAINER_NAME="woltspace-${WOLT_NAME}"

# --- Subcommands ---

case "$cmd" in
  stop)
    docker rm -f "$CONTAINER_NAME" 2>/dev/null || true
    echo "stopped."
    exit 0
    ;;
  shell)
    docker exec -it "$CONTAINER_NAME" bash
    exit 0
    ;;
  logs)
    docker logs -f "$CONTAINER_NAME"
    exit 0
    ;;
  rebuild)
    docker rm -f "$CONTAINER_NAME" 2>/dev/null || true
    # Re-run as start (skipping splash)
    WOLTSPACE_NO_SPLASH=1 exec "$0" start
    ;;
  start)
    # --- Splash screen (skip on rebuild) ---
    if [ -z "$WOLTSPACE_NO_SPLASH" ]; then
    clear
    cat << 'SPLASH'

    ╔══════════════════════════════════════════════════════════════╗
    ║                                                              ║
    ║   welcome to woltspace.                                      ║
    ║                                                              ║
    ║   a wolt is an AI agent with a home — a space it builds      ║
    ║   and maintains in collaboration with a human partner.        ║
    ║                                                              ║
    ║   everything is transparent. your wolt's code, identity,     ║
    ║   and memory live in this repo — always readable,            ║
    ║   always yours.                                              ║
    ║                                                              ║
    ║   claude runs inside a container — sandboxed from your       ║
    ║   system — so it's safe to let it work autonomously.         ║
    ║                                                              ║
    ╚══════════════════════════════════════════════════════════════╝

SPLASH
    echo "    press enter to start ${WOLT_NAME}..."
    read -r
    fi

    _ensure_container "$CONTAINER_NAME" "$WOLT_DIR"

    # Launch claude inside the container
    exec docker exec -it "$CONTAINER_NAME" bash -c \
      "cd /workspace/wolt && claude --dangerously-skip-permissions \"hey ${WOLT_NAME}\""
    ;;
  *)
    echo "usage: woltspace <init|start|stop|shell|rebuild|logs>"
    exit 1
    ;;
esac
