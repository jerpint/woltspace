# Bot LLM (pick one provider — litellm routes by model prefix)
# ANTHROPIC_API_KEY=       # for anthropic/... models
# OPENROUTER_API_KEY=      # for openrouter/... models
# LLM_MODEL=anthropic/claude-haiku-4-5-20251001

# Telegram bot
ENABLE_TELEGRAM_BOT=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=   # comma-separated IDs, or empty for open

# Slack bot (Socket Mode)
ENABLE_SLACK_BOT=false
SLACK_BOT_TOKEN=           # xoxb-...
SLACK_APP_TOKEN=           # xapp-...
SLACK_NOTIFY_CHANNEL=

# Spotify (for music curation in digests)
SPOTIFY_ID=
SPOTIFY_SECRET=
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_USER=

# Image generation
OPENAI_API_KEY=

# Remote exposure: off (default), temporary, or authenticated.
# - off: localhost only, no Cloudflare tunnel
# - temporary: random public Quick Tunnel URL; anyone with the URL can connect
# - authenticated: named tunnel; configure Cloudflare Access on the hostname
WOLTSPACE_EXPOSURE=off

# Authenticated mode also requires both values below.
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_TUNNEL_URL=https://lodge.example.com

# Deprecated compatibility setting. Prefer WOLTSPACE_EXPOSURE.
# WOLTSPACE_PUBLIC_TUNNEL=false

# Deploy key path (defaults to ~/.ssh/deploy-key)
# DEPLOY_KEY=
