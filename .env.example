# Required
CLAUDE_CODE_OAUTH_TOKEN=your_oauth_token_here
WOLT_NAME=your-wolt-name
HUMAN_NAME=your-name

# Optional: Spotify integration (for music curation in digests)
SPOTIFY_ID=
SPOTIFY_SECRET=
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_USER=

# Optional: Telegram bot
ENABLE_TELEGRAM_BOT=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Optional: Slack bot (Socket Mode)
ENABLE_SLACK_BOT=false
SLACK_BOT_TOKEN=        # xoxb-... (Bot User OAuth Token)
SLACK_APP_TOKEN=        # xapp-... (App-Level Token, for Socket Mode)
SLACK_NOTIFY_CHANNEL=   # fallback channel for notifications

# Optional: deploy key path (defaults to ~/.ssh/deploy-key)
DEPLOY_KEY=
