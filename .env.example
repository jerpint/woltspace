# Required
CLAUDE_CODE_OAUTH_TOKEN=
HUMAN_NAME=

# Bot LLM (pick one provider — litellm routes by model prefix)
# ANTHROPIC_API_KEY=       # for anthropic/... models
# OPENROUTER_API_KEY=      # for openrouter/... models
# LLM_MODEL=anthropic/claude-haiku-4-5-20251001

# Telegram bot
ENABLE_TELEGRAM_BOT=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=   # comma-separated IDs, or empty for open

# Slack bot (Socket Mode)
ENABLE_SLACK_BOT=false
SLACK_BOT_TOKEN=           # xoxb-...
SLACK_APP_TOKEN=           # xapp-...
SLACK_NOTIFY_CHANNEL=

# Spotify (for music curation in digests)
SPOTIFY_ID=
SPOTIFY_SECRET=
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_USER=

# Image generation
OPENAI_API_KEY=

# Public tunnel (set false to use http://localhost:7777 only)
# WOLTSPACE_PUBLIC_TUNNEL=false

# Deploy key path (defaults to ~/.ssh/deploy-key)
# DEPLOY_KEY=
