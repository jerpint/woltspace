{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Woltspace",
  "version": "0.1.0",
  "identifier": "space.wolt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Woltspace", "width": 1040, "height": 700, "minWidth": 720, "minHeight": 520, "center": true, "visible": true }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:7777; img-src 'self' data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "DeveloperTool",
    "shortDescription": "A desktop home for your wolts",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["woltspace"] } }
  }
}
