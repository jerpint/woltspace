{
  "display_information": {
    "name": "Woltspace",
    "description": "Woltspace",
    "background_color": "#3A6644"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Woltspace",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/wolt",
        "description": "switch or show the active wolt",
        "usage_hint": "[name]",
        "should_escape": false
      },
      {
        "command": "/new",
        "description": "start a fresh session",
        "should_escape": false
      },
      {
        "command": "/sessions",
        "description": "list sessions",
        "should_escape": false
      },
      {
        "command": "/holds",
        "description": "sessions kept awake",
        "should_escape": false
      },
      {
        "command": "/idle",
        "description": "when idle sessions rest",
        "should_escape": false
      },
      {
        "command": "/kill",
        "description": "stop a session",
        "usage_hint": "[name]",
        "should_escape": false
      },
      {
        "command": "/help",
        "description": "what you can do here",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "commands",
        "files:read",
        "files:write",
        "im:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "app_level_token_rotation_enabled": false,
    "is_mcp_enabled": false
  }
}
