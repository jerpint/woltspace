#!/usr/bin/env bash
# Push a URL to the viewport for the current session.
# Usage: push-view /path/to/page.html
#
# Auto-detects which session we're in. Just works.

URL="${1:?usage: push-view /path}"

# Auto-translate filesystem paths to URL paths.
# /workspace/wolts/<name>/wolt/site/foo.html → /wolt/<name>/site/foo.html
if [[ "$URL" == /workspace/wolts/*/wolt/site/* ]]; then
  WOLT_NAME=$(echo "$URL" | sed 's|^/workspace/wolts/\([^/]*\)/wolt/site/.*|\1|')
  FILE_PATH=$(echo "$URL" | sed 's|^/workspace/wolts/[^/]*/wolt/site/||')
  URL="/wolt/${WOLT_NAME}/site/${FILE_PATH}"
  echo "[push-view] translated filesystem path → ${URL}" >&2
fi

# Detect session: env var first (set by run-session.sh), then tmux, then main
SESSION="${WOLT_SESSION:-}"
if [ -z "$SESSION" ]; then
  SESSION=$(tmux display-message -p '#S' 2>/dev/null || true)
fi
SESSION="${SESSION:-main}"

curl -s -X POST "http://localhost:7777/current?session=${SESSION}" \
  -H 'Content-Type: application/json' \
  -d "{\"url\":\"${URL}\"}" > /dev/null

echo "[viewport:${SESSION}] → ${URL}"
