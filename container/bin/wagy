#!/bin/bash
# Use the owner's Google CLI login and keep the chosen project as the cwd.
# agy reads AGENTS.md and .agents/skills from every workspace folder.
set -eu

if [ -n "${WOLTSPACE_WOLT_HOME:-}" ] && [ ! "$PWD" -ef "$WOLTSPACE_WOLT_HOME" ]; then
    set -- --add-dir "$WOLTSPACE_WOLT_HOME" "$@"
fi
exec agy "$@"
