#!/bin/bash
# Send a notification to the originating chat (Telegram/Slack)
#
# Usage:
#   notify "message"                                  — auto-route via session registry (default: telegram)
#   notify --stdin                                     — read the message literally from standard input
#   notify --slack CHANNEL THREAD_TS "message"        — send to specific Slack thread
#   notify --telegram CHAT_ID --stdin                  — safely read a Telegram message from stdin
#
# The --slack and --telegram flags let rodents explicitly target where to send,
# based on the adapter info in their prepended message context.

# --- Parse args ---
ADAPTER=""
SLACK_CHANNEL=""
SLACK_THREAD=""
TELEGRAM_CHAT_ID=""

usage() {
  printf '%s\n' \
    'Usage:' \
    '  notify [--stdin | "message"]' \
    '  notify --telegram CHAT_ID [--stdin | "message"]' \
    '  notify --slack CHANNEL THREAD_TS [--stdin | "message"]' \
    '' \
    'Use --stdin for generated or user-controlled text so the shell never parses the message.'
}

fail_usage() {
  echo "notify: $1" >&2
  usage >&2
  exit 2
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  --slack)
    [ "$#" -ge 3 ] || fail_usage "--slack requires CHANNEL and THREAD_TS"
    ADAPTER="slack"
    SLACK_CHANNEL="$2"
    SLACK_THREAD="$3"
    shift 3
    ;;
  --telegram)
    [ "$#" -ge 2 ] || fail_usage "--telegram requires CHAT_ID"
    ADAPTER="telegram"
    TELEGRAM_CHAT_ID="$2"
    [[ "$TELEGRAM_CHAT_ID" =~ ^-?[0-9]+$ ]] || fail_usage "CHAT_ID must be an integer"
    shift 2
    ;;
  --)
    shift
    ;;
  --*)
    fail_usage "unknown option: $1"
    ;;
esac

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  --stdin)
    [ "$#" -eq 1 ] || fail_usage "--stdin does not accept a message argument"
    # The sentinel prevents command substitution from stripping trailing newlines.
    MESSAGE="$(cat; printf '\034')"
    MESSAGE="${MESSAGE%$'\034'}"
    ;;
  --)
    shift
    [ "$#" -eq 1 ] || fail_usage "expected exactly one message after --"
    MESSAGE="$1"
    ;;
  --*)
    fail_usage "unknown option: $1"
    ;;
  *)
    [ "$#" -eq 1 ] || fail_usage "expected exactly one message or --stdin"
    MESSAGE="${1:-}"
    ;;
esac

if [ -z "$MESSAGE" ]; then
  fail_usage "message must not be empty"
fi

# Both spellings: the platform stamps WOLTSPACE_WOLT_SESSION, older shells
# and skills still carry WOLT_SESSION. See docs/environment.md.
SESSION="${WOLTSPACE_WOLT_SESSION:-${WOLT_SESSION:-}}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SESSION_REG="$SCRIPT_DIR/session-reg"

# Build message — footer (session URL + reply hint) is added by server
WOLT_NAME="${WOLTSPACE_WOLT_NAME:-${WOLT_NAME:-wolt}}"

# Read creature from session registry
EMOJI="🦫"
if [ -n "$SESSION" ]; then
  CREATURE=$($SESSION_REG get-field "$SESSION" creature 2>/dev/null || echo "")
  case "$CREATURE" in
    raccoon) EMOJI="🦝" ;;
    beaver)  EMOJI="🦫" ;;
    otter)   EMOJI="🦦" ;;
    wolf)    EMOJI="🐺" ;;
  esac
fi
FULL_MESSAGE="${EMOJI} ${WOLT_NAME}: $MESSAGE"

# Build JSON payload
PAYLOAD=$(python3 -c "
import json, sys
d = {'session': sys.argv[1], 'message': sys.argv[2]}
adapter = sys.argv[3]
if adapter == 'slack':
    d['adapter'] = 'slack'
    d['channel'] = sys.argv[4]
    d['thread_ts'] = sys.argv[5]
elif adapter == 'telegram':
    d['adapter'] = 'telegram'
    d['chat_id'] = sys.argv[4]
print(json.dumps(d))
" "$SESSION" "$FULL_MESSAGE" "$ADAPTER" "${SLACK_CHANNEL:-${TELEGRAM_CHAT_ID:-}}" "${SLACK_THREAD:-}")

# The control plane that owns this session. Stamped into the session's
# environment at spawn (RuntimeLayout.apply_environment → _SESSION_ENV_KEYS);
# the literal below is only the container's baked-in default, for a shell that
# predates the stamp.
API="${WOLTSPACE_API:-http://localhost:7777}"

RESPONSE=$(curl -s -X POST "${API}/notify" \
  -H "Content-Type: application/json" \
  -d "$PAYLOAD")

if echo "$RESPONSE" | python3 -c "import json,sys; d=json.load(sys.stdin); sys.exit(0 if d.get('ok') else 1)" 2>/dev/null; then
  RESP_ADAPTER=$(echo "$RESPONSE" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('adapter','?'))")
  echo "[notify] → $RESP_ADAPTER: $MESSAGE"
else
  ERROR=$(echo "$RESPONSE" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('error','unknown error'))" 2>/dev/null || echo "$RESPONSE")
  echo "[notify] failed: $ERROR" >&2
  exit 1
fi
