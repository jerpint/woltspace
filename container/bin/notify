#!/bin/bash
# Send a notification to the originating chat (Telegram/Slack)
# Usage: notify "message"
#
# POSTs to the local server which sends directly via Telegram/Slack API.
# Works from any session — bot-spawned sessions auto-route via WOLT_SESSION.

MESSAGE="${1:-}"
if [ -z "$MESSAGE" ]; then
  echo "Usage: notify <message>" >&2
  exit 1
fi

SESSION="${WOLT_SESSION:-}"
STATE_DIR="${WOLT_STATE_DIR:-/workspace/wolts/.state}"

# Build 🦫 message with session link formatted per adapter
FULL_MESSAGE="🦫 $MESSAGE"
if [ -n "$SESSION" ]; then
  TUNNEL_URL=$(cat "$STATE_DIR/tunnel-url" 2>/dev/null | tr -d '[:space:]')
  SESSION_URL="${TUNNEL_URL}/tui?session=${SESSION}"
  # Short name: strip wolt prefix and hex suffix (neowolt-sleek-burrow-5dd665 → sleek-burrow)
  SHORT=$(echo "$SESSION" | sed 's/^[^-]*-//' | sed 's/-[0-9a-f]\{6\}$//')
  # Read adapter from routing file
  ROUTING_FILE="$STATE_DIR/session-routing/${SESSION}.json"
  ADAPTER=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d.get('adapter',''))" "$ROUTING_FILE" 2>/dev/null)

  if [ -n "$TUNNEL_URL" ]; then
    WOLT_NAME=$(echo "$SESSION" | cut -d'-' -f1)
    FULL_MESSAGE="🦫 ${WOLT_NAME}: $MESSAGE

---
session: $SESSION_URL"
  fi
fi

PAYLOAD=$(python3 -c "import json,sys; print(json.dumps({'session': sys.argv[1], 'message': sys.argv[2]}))" "$SESSION" "$FULL_MESSAGE")

RESPONSE=$(curl -s -X POST http://localhost:3000/notify \
  -H "Content-Type: application/json" \
  -d "$PAYLOAD")

if echo "$RESPONSE" | python3 -c "import json,sys; d=json.load(sys.stdin); sys.exit(0 if d.get('ok') else 1)" 2>/dev/null; then
  ADAPTER=$(echo "$RESPONSE" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('adapter','?'))")
  echo "[notify] → $ADAPTER: $MESSAGE"
else
  ERROR=$(echo "$RESPONSE" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('error','unknown error'))" 2>/dev/null || echo "$RESPONSE")
  echo "[notify] failed: $ERROR" >&2
  exit 1
fi
