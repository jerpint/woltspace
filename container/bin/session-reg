#!/bin/bash
# session-reg — CLI wrapper for the session registry (sessions.py)
# Usage: session-reg <command> [args]
#   create <name> [key=value ...]
#   update <name> [key=value ...]
#   finish <name> <exit_code>
#   get <name>
#   get-field <name> <field>
#   list [--alive] [--wolt=X]
#   touch <name>
#   reconcile

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB_DIR="$(dirname "$SCRIPT_DIR")/lib"

PYTHONPATH="$LIB_DIR:${PYTHONPATH:-}" exec python3 -c "from sessions import cli; cli()" "$@"
