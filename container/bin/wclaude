#!/bin/bash
# Wrapper that sets per-wolt HOME and trusts $PWD before launching Claude Code.
# Use this instead of bare `claude` inside the container.
#
# If $PWD is under /workspace/wolts/<name>/, set HOME to that wolt's root dir.
# This gives each wolt its own .claude/ config (settings, skills, sessions, history).
# Credentials are shared via symlink to /workspace/wolts/.credentials.json.

WOLT_HOME=$(echo "$PWD" | sed -n 's|\(/workspace/wolts/[^/]*\).*|\1|p')
if [ -n "$WOLT_HOME" ] && [ -d "$WOLT_HOME/.claude" ]; then
    export HOME="$WOLT_HOME"
    # Self-heal missing credential symlink
    CREDS_LINK="$WOLT_HOME/.claude/.credentials.json"
    SHARED_CREDS="/workspace/wolts/.claude/.credentials.json"
    if [ ! -e "$CREDS_LINK" ] && [ -f "$SHARED_CREDS" ]; then
        ln -sf "$SHARED_CREDS" "$CREDS_LINK"
    fi
fi

trust-dir "$(pwd)" 2>/dev/null
exec claude "$@"
